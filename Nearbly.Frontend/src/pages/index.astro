---
import BaseLayout from '../layouts/BaseLayout.astro'
import MarketingHeader from '../components/marketing/MarketingHeader.astro'
import MarketingFooter from '../components/marketing/MarketingFooter.astro'
import BarbaTransitions from '../components/marketing/BarbaTransitions.tsx'
import { AnimatedContent } from '../components/react-bits/AnimatedContent'
import { BlurText } from '../components/react-bits/BlurText'
import { StarBorder } from '../components/react-bits/StarBorder'
import { Magnet } from '../components/react-bits/Magnet'
import { ScrollFloat } from '../components/react-bits/ScrollFloat'
import { ScrollStack } from '../components/react-bits/ScrollStack'
import { ScrollVelocity } from '../components/react-bits/ScrollVelocity'
import ParallaxMedia from '../components/marketing/ParallaxMedia'

export const prerender = true
const siteUrl = import.meta.env.SITE_URL ?? 'https://nearbly.com.br'
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', name: 'Nearbly', url: siteUrl, areaServed: 'Curitiba, PR' },
    { '@type': 'WebSite', name: 'Nearbly', url: siteUrl, inLanguage: 'pt-BR' },
  ],
}
const homeFeatures = [
  { index: '01 / 03', label: 'Página', title: 'Seu espaço online.', description: 'Uma página pública com sua identidade, descrição, abas e links essenciais. Tudo no lugar certo para uma decisão rápida.', detail: 'Identidade · abas · links organizados' },
  { index: '02 / 03', label: 'Acesso', title: 'Chegada imediata.', description: 'QR Code e NFC reduzem a distância entre a experiência física e o próximo clique, sem exigir busca ou digitação.', detail: 'NFC · QR Code · acesso direto' },
  { index: '03 / 03', label: 'Leitura', title: 'Métricas que orientam.', description: 'Visualizações, cliques, origens e links mais acessados mostram o que as pessoas procuram depois de chegar.', detail: 'Analytics · origem · conversão' },
]
---
<BaseLayout title="Nearbly | presença digital para negócios locais" description="Uma página simples para cada negócio. Links, acessos e cliques organizados para negócios de Curitiba." canonical="/" schema={schema} barba>
  <MarketingHeader />
  <main id="conteudo">
    <section class="hero hero-photo home-hero">
      <ParallaxMedia client:load className="hero-parallax" src="/brand/home-nfc-cafe-1600.webp" srcSet="/brand/home-nfc-cafe-960.webp 960w, /brand/home-nfc-cafe-1600.webp 1600w, /brand/home-nfc-cafe-2560.webp 2560w" alt="Cliente aproximando um celular de um display Nearbly em um café" eager />
      <div class="container hero-content hero-content-overlay">
        <AnimatedContent client:load>
          <span class="eyebrow">Presença local, sem complicação</span>
          <h1><BlurText text="O seu negócio mais perto." client:load /></h1>
          <p class="hero-copy">A Nearbly transforma um QR Code ou uma aproximação NFC em uma página bonita, direta e mensurável para o seu negócio.</p>
          <div class="hero-actions">
            <StarBorder client:load href="https://wa.me/5541985306266?text=Ol%C3%A1%21%20Quero%20conhecer%20a%20Nearbly%20para%20meu%20neg%C3%B3cio%20em%20Curitiba." target="_blank" rel="noreferrer">Conhecer a Nearbly</StarBorder>
            <Magnet client:load><a class="button button-quiet" href="/como-funciona">Ver como funciona</a></Magnet>
          </div>
        </AnimatedContent>
      </div>
    </section>
    <ScrollVelocity client:visible texts={['NFC · QR CODE · PÁGINA DIGITAL · ANALYTICS ·', 'NEGÓCIOS LOCAIS · CURITIBA · MAIS PERTO ·']} />
    <section class="page-section soft stack-story">
      <div class="container stack-story-intro">
        <div class="section-heading"><span class="eyebrow">Uma presença que trabalha</span><ScrollFloat client:visible text="Menos caminhos perdidos. Mais conversas iniciadas." /><p>Organize seus principais links em um único lugar e entenda o que as pessoas procuram depois de conhecer o seu espaço.</p></div>
      </div>
      <ScrollStack client:visible className="container" items={homeFeatures} />
    </section>
    <section class="brand-canvas" aria-label="Nearbly, conexões mais próximas"><img src="/brand/nearbly-wordmark-3d.webp" alt="Nearbly" loading="lazy" width="2400" height="756" /></section>
    <section class="cta-band"><div class="container cta-band-inner"><h2>Pronto para deixar seu negócio mais perto?</h2><a class="button button-primary" href="https://wa.me/5541985306266?text=Ol%C3%A1%21%20Quero%20conhecer%20a%20Nearbly%20para%20meu%20neg%C3%B3cio%20em%20Curitiba." target="_blank" rel="noreferrer">Falar no WhatsApp</a></div></section>
  </main>
  <MarketingFooter />
  <BarbaTransitions client:load />
</BaseLayout>
