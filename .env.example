ASPNETCORE_ENVIRONMENT=Development
POSTGRES_DB=nearbly
POSTGRES_USER=nearbly
POSTGRES_PASSWORD=NearblyLocalDatabase123
DATABASE_PORT=5432
ConnectionStrings__Default=Host=localhost;Port=5432;Database=nearbly;Username=nearbly;Password=NearblyLocalDatabase123
Jwt__Issuer=Nearbly
Jwt__Audience=Nearbly.Admin
Jwt__SigningKey=replace-with-a-random-32-byte-development-key
Jwt__ExpirationMinutes=60
BootstrapAdmin__Email=admin@example.com
BootstrapAdmin__Password=ChangeThisLocalPassword123
BootstrapAdmin__DisplayName="Nearbly Admin"
Cors__AllowedOrigins__0=http://localhost:4321
Swagger__Enabled=false
Media__Provider=filesystem
Media__RootPath=./.data/media
# For S3-compatible storage, set Media__Provider=s3 and provide all values below.
# Media__S3__Endpoint=https://s3.example.com
# Media__S3__Bucket=nearbly-media
# Media__S3__AccessKey=
# Media__S3__SecretKey=
